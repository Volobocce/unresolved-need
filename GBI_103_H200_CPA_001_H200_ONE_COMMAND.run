#!/usr/bin/env bash
set -Eeuo pipefail

NAME="GBI_103_H200_CPA_001_PLUG_AND_PLAY"
HERE="$PWD"
ZIP="$HERE/${NAME}.zip"
DIR="$HERE/$NAME"
PAYLOAD_SHA="56e5950e296cbb871130c00b491e15dae09f1e7a23bfd848c48601392578bb72"

fail() {
  echo
  echo "============================================================"
  echo "CPA-001 ONE-COMMAND INSTALL/RUN — FAIL-CLOSED"
  echo "============================================================"
  echo "$1"
  exit 1
}

echo "============================================================"
echo "GBI-103-H200-CPA-001 — ONE-COMMAND H200 RUNNER"
echo "============================================================"
echo "Working directory: $HERE"

command -v base64 >/dev/null 2>&1 || fail "base64 is unavailable."
command -v unzip >/dev/null 2>&1 || fail "unzip is unavailable."
command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is unavailable."

rm -f "$ZIP"
rm -rf "$DIR"

awk '/^__CPA001_PAYLOAD_BELOW__$/ {found=1; next} found {print}' "$0" | base64 -d > "$ZIP"   || fail "Could not unpack embedded CPA-001 payload."

ACTUAL_SHA="$(sha256sum "$ZIP" | awk '{print $1}')"
[[ "$ACTUAL_SHA" == "$PAYLOAD_SHA" ]]   || fail "Embedded payload checksum mismatch. Expected $PAYLOAD_SHA; got $ACTUAL_SHA"

echo "Embedded package SHA-256: PASS"
unzip -q "$ZIP" || fail "Could not unzip embedded CPA-001 package."
[[ -x "$DIR/RUN_CPA_001.sh" ]] || chmod +x "$DIR/RUN_CPA_001.sh"

echo
echo "Package installed. Starting H200 preflight and canonical campaign automatically."
echo
cd "$DIR"
exec ./RUN_CPA_001.sh
exit 99
__CPA001_PAYLOAD_BELOW__
....TRUNCATED_FOR_BREVITY....